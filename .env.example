# Copy to .env and replace every key with a long random value (at least 24 characters), for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Roles: viewer (read), planner (also what-if and sizing), operator (also readings, closures, metering).
ITWIN_API_KEYS=viewer:CHANGE_ME_viewer_key_000000,planner:CHANGE_ME_planner_key_00000,operator:CHANGE_ME_operator_key_0000
# demo = built-in synthetic road and feed; feed = readings arrive through POST /v1/readings
ITWIN_MODE=demo
# demo mode only: simulated seconds per real second
ITWIN_SPEED=20
